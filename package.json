{
  "name": "opencode-ambient",
  "version": "0.1.0",
  "description": "Ambient lights for opencode — Hue + Govee glow as your agents build, fix, ship",
  "type": "module",
  "license": "MIT",
  "author": "Vocino (https://vocino.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vocino/opencode-ambient.git"
  },
  "bin": {
    "opencode-ambient": "dist/index.js"
  },
  "main": "./dist/plugin.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": ["dist/", "README.md", "LICENSE", "opencode.json.example"],
  "keywords": ["opencode", "opencode-plugin", "philips-hue", "govee", "ambient", "glow"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.0.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.11",
    "@types/node": "^22.20.1",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  },
  "engines": { "node": ">=18" }
}
